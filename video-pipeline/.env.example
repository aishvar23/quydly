# Required
ANTHROPIC_API_KEY=

# TTS — if absent, pipeline stubs audio with estimated timing
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Stock assets — if absent, pipeline falls back to map / motion graphic
PEXELS_API_KEY=

# Maps — if absent, geo scenes fall back to motion graphic
MAPBOX_TOKEN=

# DALL-E fallback — optional, conceptual/non-literal visuals only
OPENAI_API_KEY=

# Supabase — for story intake
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Font path for subtitle burn-in and lower-thirds
# Windows default: C:/Windows/Fonts/arialbd.ttf
# Linux default:   /usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf
FONT_PATH=
