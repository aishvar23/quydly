# Required
ANTHROPIC_API_KEY=

# TTS — if absent, pipeline stubs audio with estimated timing
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Stock assets — if absent, scenes fall back to motion graphic
PEXELS_API_KEY=

# Maps — if absent, geo scenes fall back to motion graphic background
MAPBOX_TOKEN=

# Supabase — for story intake
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Font path for FFmpeg subtitle burn-in (only used in 09-ffmpeg-export)
# Windows default: C:/Windows/Fonts/arialbd.ttf
# Linux default:   /usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf
FONT_PATH=
