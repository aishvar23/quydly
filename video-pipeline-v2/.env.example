# Supabase — required by tools/ (and by the render pipeline in src/).
# Copy this file to `.env` and fill in the values from your Supabase
# project's Settings → API page.
#
# DO NOT commit the populated .env. The .gitignore already excludes it.

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service-role key (RLS bypass). Never put this in a client-side bundle.
# This is the `service_role` secret, not the `anon` public key.
SUPABASE_SERVICE_KEY=


# --- Optional: only required for the render pipeline (not tools/) -----------

# Anthropic — used by --use-ai script generation in src/.
ANTHROPIC_API_KEY=

# ElevenLabs — used for real TTS during render. Without it, the renderer
# falls back to synthetic timing.
ELEVENLABS_API_KEY=

# Mapbox — used for off-gazetteer geo resolution and map asset rendering.
MAPBOX_TOKEN=
MAPBOX_AUTO_GEOCODE=true
